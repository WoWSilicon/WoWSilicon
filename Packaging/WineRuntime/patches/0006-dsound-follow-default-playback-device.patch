+static HRESULT WINAPI default_notifier_QueryInterface(IMMNotificationClient *iface,
+        REFIID riid, void **obj)
+{
+    if (!obj) return E_POINTER;
+    *obj = NULL;
+    if (!IsEqualIID(riid, &IID_IUnknown) && !IsEqualIID(riid, &IID_IMMNotificationClient))
+        return E_NOINTERFACE;
+    *obj = iface;
+    IMMNotificationClient_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI default_notifier_AddRef(IMMNotificationClient *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI default_notifier_Release(IMMNotificationClient *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI default_notifier_OnDeviceStateChanged(IMMNotificationClient *iface,
+        const WCHAR *device_id, DWORD new_state)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI default_notifier_OnDeviceAdded(IMMNotificationClient *iface,
+        const WCHAR *device_id)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI default_notifier_OnDeviceRemoved(IMMNotificationClient *iface,
+        const WCHAR *device_id)
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI default_notifier_OnDefaultDeviceChanged(IMMNotificationClient *iface,
+        EDataFlow flow, ERole role, const WCHAR *device_id)
+{
+    IMMDeviceEnumerator *devenum;
+    IMMDevice *mmdevice;
+    GUID guid;
+    HRESULT hr, init_hr;
+
+    if (flow != eRender || role != eMultimedia || !device_id)
+        return S_OK;
+
+    init_hr = get_mmdevenum(&devenum);
+    if (!devenum)
+        return S_OK;
+
+    hr = IMMDeviceEnumerator_GetDevice(devenum, device_id, &mmdevice);
+    if (SUCCEEDED(hr)) {
+        hr = get_mmdevice_guid(mmdevice, NULL, &guid);
+        if (SUCCEEDED(hr))
+            DSOUND_DefaultDeviceChanged(mmdevice, &guid);
+        IMMDevice_Release(mmdevice);
+    }
+    release_mmdevenum(devenum, init_hr);
+    return S_OK;
+}
+
+static HRESULT WINAPI default_notifier_OnPropertyValueChanged(IMMNotificationClient *iface,
+        const WCHAR *device_id, const PROPERTYKEY key)
+{
+    return S_OK;
+}
+
+static const IMMNotificationClientVtbl default_notifier_vtbl = {
+    default_notifier_QueryInterface,
+    default_notifier_AddRef,
+    default_notifier_Release,
+    default_notifier_OnDeviceStateChanged,
+    default_notifier_OnDeviceAdded,
+    default_notifier_OnDeviceRemoved,
+    default_notifier_OnDefaultDeviceChanged,
+    default_notifier_OnPropertyValueChanged
+};
+
+static IMMNotificationClient default_notifier = { &default_notifier_vtbl };
+static LONG default_notifier_registered;
+
+void DSOUND_RegisterDefaultDeviceNotifications(void)
+{
+    IMMDeviceEnumerator *devenum;
+    HRESULT hr, init_hr;
+
+    if (InterlockedCompareExchange(&default_notifier_registered, 1, 0))
+        return;
+
+    init_hr = get_mmdevenum(&devenum);
+    if (!devenum) {
+        InterlockedExchange(&default_notifier_registered, 0);
+        return;
+    }
+
+    hr = IMMDeviceEnumerator_RegisterEndpointNotificationCallback(devenum, &default_notifier);
+    release_mmdevenum(devenum, init_hr);
+    if (FAILED(hr)) {
+        WARN("failed to register default device notification: %08lx\n", hr);
+        InterlockedExchange(&default_notifier_registered, 0);
+    }
+}
