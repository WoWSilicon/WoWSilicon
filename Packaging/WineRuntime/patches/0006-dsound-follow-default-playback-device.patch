     TRACE("(%p,%s)\n",ppDevice,debugstr_guid(lpcGUID));
 
@@ -247,6 +258,9 @@ static HRESULT DirectSoundDevice_Initialize(DirectSoundDevice ** ppDevice, LPCGU
         return DSERR_ALREADYINITIALIZED;
     }
 
