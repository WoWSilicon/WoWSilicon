diff --git a/dlls/winemac.drv/cocoa_gcmouse.m b/dlls/winemac.drv/cocoa_gcmouse.m
new file mode 100644
index 00000000000..5096768e7af
--- /dev/null
+++ b/dlls/winemac.drv/cocoa_gcmouse.m
@@ -0,0 +1,159 @@
+/*
+ * MACDRV GameController mouse support
+ *
+ * Copyright 2026 Elvin Hayatov
