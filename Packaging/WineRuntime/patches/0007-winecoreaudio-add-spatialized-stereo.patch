+static enum spatial_audio_mode parse_spatial_audio_mode(const char *value,
+                                                        enum spatial_audio_mode fallback)
+{
+    size_t length;
+
+    if (!value) return fallback;
+    length = strcspn(value, "\r\n");
+    if (length == 3 && !strncmp(value, "off", length)) return SPATIAL_AUDIO_OFF;
+    if (length == 5 && !strncmp(value, "fixed", length)) return SPATIAL_AUDIO_FIXED;
+    return fallback;
+}
+
+static BOOL parse_night_mode(const char *value, BOOL fallback)
+{
+    size_t length;
+
+    if (!value) return fallback;
+    length = strcspn(value, "\r\n");
+    if ((length == 1 && value[0] == '1') || (length == 2 && !strncmp(value, "on", length)))
+        return TRUE;
+    if ((length == 1 && value[0] == '0') || (length == 3 && !strncmp(value, "off", length)))
+        return FALSE;
+    return fallback;
+}
+
+static BOOL read_night_mode(const char *path, BOOL fallback)
+{
+    char buffer[32];
+    ssize_t count;
+    int fd;
+
+    if (!path || (fd = open(path, O_RDONLY)) == -1) return fallback;
+    count = read(fd, buffer, sizeof(buffer) - 1);
+    close(fd);
+    if (count <= 0) return fallback;
+    buffer[count] = 0;
+    return parse_night_mode(buffer, fallback);
+}
+
+static BOOL ca_apply_night_mode(struct coreaudio_stream *stream, BOOL enabled)
+{
+    stream->night_mode = enabled;
+    TRACE("Night Mode changed to %s\n", enabled ? "on" : "off");
+    return TRUE;
+}
+
+static void ca_setup_night_mode(struct coreaudio_stream *stream)
+{
+    const char *control_path = getenv("WOWSILICON_NIGHT_MODE_CONTROL");
+
+    stream->night_mode = parse_night_mode(getenv("WOWSILICON_NIGHT_MODE"), FALSE);
+    stream->night_gain = 1.0f;
+    if (control_path && *control_path)
+    {
+        if ((stream->night_control_path = strdup(control_path)))
+            stream->night_mode = read_night_mode(stream->night_control_path,
+                                                 stream->night_mode);
+    }
+    TRACE("Night Mode initialized %s\n", stream->night_mode ? "on" : "off");
+}
+
+static enum spatial_audio_mode read_spatial_audio_mode(const char *path,
+                                                       enum spatial_audio_mode fallback)
+{
+    char buffer[32];
+    ssize_t count;
+    int fd;
+
+    if (!path || (fd = open(path, O_RDONLY)) == -1) return fallback;
+    count = read(fd, buffer, sizeof(buffer) - 1);
+    close(fd);
+    if (count <= 0) return fallback;
+    buffer[count] = 0;
+    return parse_spatial_audio_mode(buffer, fallback);
+}
+
+static const char *spatial_audio_mode_name(enum spatial_audio_mode mode)
+{
+    switch (mode)
+    {
+    case SPATIAL_AUDIO_OFF: return "off";
+    case SPATIAL_AUDIO_FIXED: return "fixed";
+    }
+    return "unknown";
+}
+
+static BOOL ca_apply_spatial_audio_mode(struct coreaudio_stream *stream,
+                                        enum spatial_audio_mode mode)
+{
+    UInt32 value = mode == SPATIAL_AUDIO_OFF ? kSpatialMixerSourceMode_Bypass
+                                              : kSpatialMixerSourceMode_AmbienceBed;
+    OSStatus sc;
+
+    sc = AudioUnitSetProperty(stream->spatial_unit, kAudioUnitProperty_SpatialMixerSourceMode,
+                              kAudioUnitScope_Input, 0, &value, sizeof(value));
+    if (sc != noErr)
+    {
+        WARN("Couldn't change spatial mixer source mode: %x\n", (int)sc);
+        return FALSE;
+    }
+
+    stream->spatial_mode = mode;
+    TRACE("Headphone spatialization changed to %s\n", spatial_audio_mode_name(mode));
+    return TRUE;
+}
+
+static OSStatus ca_spatial_render_cb(void *user, AudioUnitRenderActionFlags *flags,
+                                    const AudioTimeStamp *ts, UInt32 bus, UInt32 nframes,
+                                    AudioBufferList *data)
+{
+    struct coreaudio_stream *stream = user;
+    return AudioUnitRender(stream->spatial_unit, flags, ts, 0, nframes, data);
+}
