+static BOOL ca_setup_spatial_audiounit(struct coreaudio_stream *stream)
+{
+    AudioStreamBasicDescription output_desc;
+    AudioChannelLayout layout = {0};
+    AURenderCallbackStruct input;
+    UInt32 size;
+    UInt32 value;
+    OSStatus sc;
+    const char *control_path;
+    const char *legacy_value;
+    const char *mode_value;
+
+    control_path = getenv("WOWSILICON_SPATIAL_AUDIO_CONTROL");
+    legacy_value = getenv("WOWSILICON_SPATIAL_AUDIO");
+    mode_value = getenv("WOWSILICON_SPATIAL_AUDIO_MODE");
+    stream->spatial_mode = parse_spatial_audio_mode(mode_value,
+            legacy_value && !strcmp(legacy_value, "1")
+            ? SPATIAL_AUDIO_FIXED : SPATIAL_AUDIO_OFF);
+
+    if (stream->flow != eRender || stream->fmt->nChannels != 2 ||
+        ((!control_path || !*control_path) && stream->spatial_mode == SPATIAL_AUDIO_OFF))
+        return FALSE;
+
+    if (control_path && *control_path)
+    {
+        if (!(stream->spatial_control_path = strdup(control_path))) return FALSE;
+        stream->spatial_mode = read_spatial_audio_mode(stream->spatial_control_path,
+                                                       stream->spatial_mode);
+    }
+
+    if (!(stream->spatial_unit = get_spatial_audiounit())) return FALSE;
+
+    size = sizeof(output_desc);
+    sc = AudioUnitGetProperty(stream->spatial_unit, kAudioUnitProperty_StreamFormat,
+                              kAudioUnitScope_Output, 0, &output_desc, &size);
+    if (sc != noErr)
+    {
+        WARN("Couldn't get spatial mixer output format: %x\n", (int)sc);
+        goto failed;
+    }
+    dump_adesc("spatial output", &output_desc);
+
+    sc = AudioUnitSetProperty(stream->spatial_unit, kAudioUnitProperty_StreamFormat,
+                              kAudioUnitScope_Input, 0, &stream->dev_desc,
+                              sizeof(stream->dev_desc));
+    if (sc != noErr)
+    {
+        WARN("Couldn't set spatial mixer input format: %x\n", (int)sc);
+        goto failed;
+    }
+
+    layout.mChannelLayoutTag = kAudioChannelLayoutTag_Stereo;
+    sc = AudioUnitSetProperty(stream->spatial_unit, kAudioUnitProperty_AudioChannelLayout,
+                              kAudioUnitScope_Input, 0, &layout, sizeof(layout));
+    if (sc != noErr)
+    {
+        WARN("Couldn't set spatial mixer channel layout: %x\n", (int)sc);
+        goto failed;
+    }
+
+    value = kSpatializationAlgorithm_UseOutputType;
+    sc = AudioUnitSetProperty(stream->spatial_unit, kAudioUnitProperty_SpatializationAlgorithm,
+                              kAudioUnitScope_Input, 0, &value, sizeof(value));
+    if (sc != noErr)
+    {
+        WARN("Couldn't set spatial mixer algorithm: %x\n", (int)sc);
+        goto failed;
+    }
+
+    value = kSpatialMixerOutputType_Headphones;
+    sc = AudioUnitSetProperty(stream->spatial_unit, kAudioUnitProperty_SpatialMixerOutputType,
+                              kAudioUnitScope_Global, 0, &value, sizeof(value));
+    if (sc != noErr)
+    {
+        WARN("Couldn't set spatial mixer output type: %x\n", (int)sc);
+        goto failed;
+    }
+
+    value = kSpatialMixerPersonalizedHRTFMode_Off;
+    sc = AudioUnitSetProperty(stream->spatial_unit,
+                              kAudioUnitProperty_SpatialMixerPersonalizedHRTFMode,
+                              kAudioUnitScope_Global, 0, &value, sizeof(value));
+    if (sc != noErr)
+        WARN("Couldn't disable personalized spatial mixer HRTF: %x\n", (int)sc);
+
+    value = 0;
+    sc = AudioUnitSetProperty(stream->spatial_unit, kAudioUnitProperty_UsesInternalReverb,
+                              kAudioUnitScope_Global, 0, &value, sizeof(value));
+    if (sc != noErr)
+        WARN("Couldn't disable spatial mixer reverb: %x\n", (int)sc);
+
+    if (!ca_apply_spatial_audio_mode(stream, stream->spatial_mode)) goto failed;
+
+    input.inputProc = ca_render_cb;
+    input.inputProcRefCon = stream;
+    sc = AudioUnitSetProperty(stream->spatial_unit, kAudioUnitProperty_SetRenderCallback,
+                              kAudioUnitScope_Input, 0, &input, sizeof(input));
+    if (sc != noErr)
+    {
+        WARN("Couldn't set spatial mixer callback: %x\n", (int)sc);
+        goto failed;
+    }
+
+    sc = AudioUnitInitialize(stream->spatial_unit);
+    if (sc != noErr)
+    {
+        WARN("Couldn't initialize spatial mixer: %x\n", (int)sc);
+        goto failed;
+    }
+
+    sc = AudioUnitSetProperty(stream->unit, kAudioUnitProperty_StreamFormat,
+                              kAudioUnitScope_Input, 0, &output_desc,
+                              sizeof(output_desc));
+    if (sc != noErr)
+    {
+        WARN("Couldn't connect spatial mixer to output unit: %x\n", (int)sc);
+        goto failed;
+    }
+    stream->spatial_output_desc = output_desc;
+
+    TRACE("Headphone spatialization mixer enabled\n");
+    return TRUE;
+
+failed:
+    AudioComponentInstanceDispose(stream->spatial_unit);
+    stream->spatial_unit = NULL;
+    WARN("Falling back to direct CoreAudio output\n");
+    return FALSE;
+}
