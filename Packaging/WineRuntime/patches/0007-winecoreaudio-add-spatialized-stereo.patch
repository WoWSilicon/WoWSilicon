+static AudioComponentInstance get_spatial_audiounit(void)
+{
+    AudioComponentDescription desc = {0};
+    AudioComponentInstance unit;
+    AudioComponent comp;
+    OSStatus sc;
+
+    desc.componentType = kAudioUnitType_Mixer;
+    desc.componentSubType = kAudioUnitSubType_SpatialMixer;
+    desc.componentManufacturer = kAudioUnitManufacturer_Apple;
+
+    if (!(comp = AudioComponentFindNext(NULL, &desc)))
+    {
+        WARN("Spatial mixer AudioComponentFindNext failed\n");
+        return NULL;
+    }
+
+    sc = AudioComponentInstanceNew(comp, &unit);
+    if (sc != noErr)
+    {
+        WARN("Spatial mixer AudioComponentInstanceNew failed: %x\n", (int)sc);
+        return NULL;
+    }
+
+    return unit;
+}
