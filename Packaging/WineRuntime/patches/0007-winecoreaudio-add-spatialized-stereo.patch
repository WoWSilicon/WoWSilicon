+static void ca_follow_system_device(struct coreaudio_stream *stream)
+{
+    AudioStreamBasicDescription new_desc, old_desc;
+    AudioConverterRef new_converter = NULL, old_converter;
+    AudioComponentInstance new_unit, old_unit;
+    AURenderCallbackStruct input;
+    AudioDeviceID new_id, old_id;
+    BYTE *new_buffer = NULL, *old_buffer;
+    UINT32 new_frames = 0, old_frames, old_offset, old_held;
+    HRESULT hr;
+    OSStatus sc;
+    BOOL verification_retry = FALSE;
+
+    if (stream->clear_system_device_pulse)
+    {
+        pulse_system_device_notification(stream->flow, TRUE);
+        stream->clear_system_device_pulse = FALSE;
+    }
+
