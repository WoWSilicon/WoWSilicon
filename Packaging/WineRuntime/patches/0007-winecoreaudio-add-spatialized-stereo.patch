+enum night_sample_kind
+{
+    NIGHT_SAMPLE_UNSUPPORTED,
+    NIGHT_SAMPLE_U8,
+    NIGHT_SAMPLE_S16,
+    NIGHT_SAMPLE_S32,
+    NIGHT_SAMPLE_F32,
