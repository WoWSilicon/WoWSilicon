+static AudioDeviceID get_default_device_id(EDataFlow flow)
+{
+    AudioObjectPropertyAddress addr =
+    {
+        .mScope = kAudioObjectPropertyScopeGlobal,
+        .mElement = kAudioObjectPropertyElementMain,
+        .mSelector = flow == eCapture ? kAudioHardwarePropertyDefaultInputDevice
+                                     : kAudioHardwarePropertyDefaultOutputDevice,
+    };
+    AudioDeviceID id = kAudioObjectUnknown;
+    UInt32 size = sizeof(id);
+    OSStatus sc;
+
+    sc = AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, 0, NULL, &size, &id);
+    if (sc != noErr)
+    {
+        WARN("Failed to get system default audio device: %x\n", (int)sc);
+        return kAudioObjectUnknown;
+    }
+    return id;
+}
