         forceNextMouseMoveAbsolute = TRUE;
+
+        // macOS can replace the application cursor while switching spaces or
+        // leaving Mission Control without updating our cached cursor state.
+        cursorIsCurrent = FALSE;
+        cursorHidden = FALSE;
+        [self updateCursor:FALSE];
     }
 
